# Dev-only credentials so the demo starts with one command (`make up` copies this to .env).
# Production injects secrets from a secrets manager; nothing here is a real secret.
POSTGRES_PASSWORD=omics-admin
PIPELINE_DB_PASSWORD=pipeline-dev
API_DB_PASSWORD=api-dev
RESEARCH_DB_PASSWORD=research-dev
MONITOR_DB_PASSWORD=monitor-dev
DASHBOARD_DB_PASSWORD=dashboard-dev
AGENT_DB_PASSWORD=agent-dev
# Must match config/seaweedfs/s3.json (one identity per service, least privilege).
S3_ADMIN_KEY=admin
S3_ADMIN_SECRET=admin-dev-secret
S3_LAB_KEY=lab
S3_LAB_SECRET=lab-dev-secret
S3_PIPELINE_KEY=pipeline
S3_PIPELINE_SECRET=pipeline-dev-secret
S3_ANALYSIS_KEY=analysis
S3_ANALYSIS_SECRET=analysis-dev-secret
# API keys map to roles: research sees SDTM only; ops also sees quarantine, alerts, lineage.
API_KEYS=research:research-key-dev,ops:ops-key-dev
# MCP bearer tokens, one per LLM client (client:token): every tool call is attributed.
AGENT_TOKENS=claude:agent-token-dev
# Simulation knobs.
SIM_SPEED=1.0
CHAOS_FAIL_RATE=0.0
